# ========================================
# Yuuko CS2 道具库项目
# 上传代码，忽略数据和临时文件
# ========================================

# ========================================
# Python 编译文件和缓存
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
env/
venv/
*.egg-info/
dist/
build/

# ========================================
# 数据库文件（不上传）
# ========================================
*.db
*.sqlite
*.sqlite3
backend/data/
backend/data/*.db

# ========================================
# 输出文件（截图和JSON数据不上传）
# ========================================
output/
output/screenshots/
output/screenshots/*.jpg
output/screenshots/*.png
output/data/
output/data/*.json
output/commands/*.json

# ========================================
# Demo 文件（不上传，体积大）
# ========================================
demos/*.dem
# 保留 .gitkeep 文件以保持目录结构
!demos/.gitkeep

# ========================================
# 导出的前端数据（不上传，由导出脚本生成）
# ========================================
public/data/*.json
public/images/

# ========================================
# IDE 和编辑器配置
# ========================================
.vscode/
.idea/
*.swp
*.swo
.kiro/

# ========================================
# 系统文件
# ========================================
.DS_Store
Thumbs.db
desktop.ini

# ========================================
# 日志文件
# ========================================
*.log

# ========================================
# 环境变量（可能包含敏感信息）
# ========================================
.env
.env.local
.env.*.local

# ========================================
# Node modules（如果使用）
# ========================================
node_modules/
package-lock.json
yarn.lock

# ========================================
# 临时文件
# ========================================
*.tmp
*.temp
*.bak
*.backup

# ========================================
# 保留的文件（强制包含）
# ========================================
# 保留代码目录
!public/
!public/**/*.html
!public/**/*.css
!public/**/*.js
!public/**/*.png
!public/**/*.jpg
!public/favicon.png
!public/apple-touch-icon.png

!client/
!client/**/*.py
!client/**/*.html
!client/**/*.css
!client/**/*.js

!backend/
!backend/**/*.py

# 保留文档
!*.md
!README.md

# 保留批处理文件（启动脚本等）
!*.bat

