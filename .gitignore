# ========================================
# Yuuko CS2 道具库项目
# 白名单模式：只显示指定的文件夹
# ========================================

# ========================================
# 第一步：忽略所有文件
# ========================================
/*

# ========================================
# 第二步：强制包含需要追踪的文件夹和文件
# ========================================

# 保留代码目录
!public/
!client/
!backend/

# 保留根目录的配置文件
!.gitignore
!README.md

# ========================================
# 第三步：在包含的目录中，排除不需要的内容
# ========================================

# Python 缓存
**/__pycache__/
**/*.pyc
**/*.py[cod]
**/*$py.class
**/*.so

# 数据库文件
backend/data/
**/*.db
**/*.sqlite
**/*.sqlite3

# 输出文件
output/
demos/

# 导出的前端数据
public/data/
public/images/

# IDE 配置
.vscode/
.idea/
.kiro/
**/*.swp
**/*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
**/*.log

# 环境变量
.env
.env.local
.env.*.local

# Node modules
node_modules/

# 临时文件
**/*.tmp
**/*.temp
**/*.bak
**/*.backup

